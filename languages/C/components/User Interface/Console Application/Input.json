 "mask": "<RPWI:NEWSTEP> #{var} = Input #{type:item} : #{prompt:item}\nprintf(\"%s\", \"#{prompt}\");\n<RPWI:VALUE> 0\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{decl}\n  <RPWI:VALUE> text\n  <RPWI:POSITIVE>\n  <RPWI:TEST> #{type}\n    char #{var}[256];\n  <RPWI:ENDTEST>\n  <RPWI:VALUE> text\n  <RPWI:NEGATIVE>\n  <RPWI:TEST> #{type}\n    #{type} #{var};\n  <RPWI:ENDTEST>\n<RPWI:ENDTEST>\n<RPWI:POSITIVE>\n<RPWI:VALUE> int\n<RPWI:TEST> #{type}\n  scanf(\"%d\", &#{var});\n<RPWI:ENDTEST>\n<RPWI:VALUE> double\n<RPWI:TEST> #{type}\n  scanf(\"%lf\", &#{var});\n<RPWI:ENDTEST>\n<RPWI:VALUE> text\n<RPWI:TEST> #{type}\n  scanf(\" %255[^\\n]\", #{var});\n<RPWI:ENDTEST>",
 "rules": {
