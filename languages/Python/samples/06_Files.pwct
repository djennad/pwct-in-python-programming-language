        "name": "lines = Read file \"pypwct_test.txt\" as List of lines",
        "code": "with open(\"pypwct_test.txt\", \"r\", encoding=\"utf-8\") as _pwct_file:\n<RPWI:TABPUSH>\nlines = _pwct_file.read().splitlines()\n<RPWI:TABPOP>\n",
