         }
        ]
       }
      ]
     },
     {
      "id": "22_",
      "name": "The window",
      "children": [
       {
        "id": "24_",
        "name": "Window win1 : PyPWCT Calculator",
        "code": "import tkinter as tk\nwin1 = tk.Tk()\nwin1.title(\"PyPWCT Calculator\")\nwin1.geometry(str(360) + \"x\" + str(220))\nwin1.configure(bg=\"#f0f0ff\")\n",
        "interaction": "23_",
        "internum": 1,
        "children": [
         {
          "id": "25_",
          "name": "Start Here",
          "interaction": "23_",
          "internum": 2,
          "children": [
           {
            "id": "28_",
            "name": "Label label1 : First number",
            "code": "label1 = tk.Label(win1, text=\"First number\", font=(\"Arial\", 11))\nlabel1.place(x=20, y=20)\n",
            "interaction": "27_",
            "internum": 1
           },
           {
            "id": "30_",
            "name": "Text Box text1",
            "code": "text1 = tk.Entry(win1, width=20, font=(\"Arial\", 11))\ntext1.place(x=150, y=22)\n",
            "interaction": "29_",
            "internum": 1
           },
           {
            "id": "32_",
            "name": "Label label2 : Second number",
            "code": "label2 = tk.Label(win1, text=\"Second number\", font=(\"Arial\", 11))\nlabel2.place(x=20, y=60)\n",
            "interaction": "31_",
            "internum": 1
           },
           {
            "id": "34_",
            "name": "Text Box text2",
            "code": "text2 = tk.Entry(win1, width=20, font=(\"Arial\", 11))\ntext2.place(x=150, y=62)\n",
            "interaction": "33_",
            "internum": 1
           },
           {
            "id": "36_",
            "name": "Button button1 : Add",
            "code": "button1 = tk.Button(win1, text=\"  Add  \", font=(\"Arial\", 10), command=add_numbers)\nbutton1.place(x=150, y=100)\n",
            "interaction": "35_",
            "internum": 1
           },
           {
            "id": "38_",
            "name": "Label label3 : Result :",
            "code": "label3 = tk.Label(win1, text=\"Result :\", font=(\"Arial\", 14))\nlabel3.place(x=20, y=150)\n",
            "interaction": "37_",
            "internum": 1
           }
          ]
         },
         {
          "id": "26_",
          "name": "End of Window win1",
          "code": "win1.mainloop()\n",
          "interaction": "23_",
          "internum": 3
         }
        ]
       }
      ]
     }
    ]
   }
  }
 ],
