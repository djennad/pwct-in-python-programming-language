 "mask": "<RPWI:NEWSTEP> Window #{name} : #{title:item}\nimport tkinter as tk\n#{name} = tk.Tk()\n#{name}.title(\"#{title}\")\n#{name}.geometry(str(#{width}) + \"x\" + str(#{height}))\n#{name}.configure(bg=\"#{bg}\")\n<RPWI:PUTMARK> 2\n<RPWI:SETMARK> 2\n<RPWI:NEWSTEP> Start Here\n<RPWI:NEWSTEP> End of Window #{name}\n<RPWI:VALUE> 0\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{show}\n  #{name}.mainloop()\n<RPWI:ENDTEST>",
 "rules": {
  "allow_root": [
   1
  ],
  "allow_interaction": [
   2
  ],
  "requires_ancestor": []
 },
 "designer": {
  "type": "window",
  "container": 2,
  "props": {
   "name": "name",
   "title": "title",
   "w": "width",
   "h": "height",
   "bg": "bg",
   "show": "show"
  }
 }
