 "mask": "<RPWI:NEWSTEP> List Box #{name}\n#{name} = tk.Listbox(#{win}, font=(\"Arial\", #{size}), exportselection=False)\n<RPWI:VALUE>\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{items}\n  for _pwct_item in [#{items}]:\n  <RPWI:TABPUSH>\n  #{name}.insert(tk.END, _pwct_item)\n  <RPWI:TABPOP>\n<RPWI:ENDTEST>\n\n<RPWI:VALUE>\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{fg}\n  #{name}.config(fg=\"#{fg}\")\n<RPWI:ENDTEST>\n<RPWI:TEST> #{bg}\n  #{name}.config(bg=\"#{bg}\")\n<RPWI:ENDTEST>\n#{name}.place(x=#{x}, y=#{y})\n<RPWI:TEST> #{w}\n  #{name}.place_configure(width=#{w})\n<RPWI:ENDTEST>\n<RPWI:TEST> #{h}\n  #{name}.place_configure(height=#{h})\n<RPWI:ENDTEST>",
 "rules": {
  "allow_root": [
   1
  ],
  "allow_interaction": [],
  "requires_ancestor": []
 },
