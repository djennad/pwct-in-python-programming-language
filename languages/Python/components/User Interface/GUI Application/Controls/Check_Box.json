 "mask": "<RPWI:NEWSTEP> Check Box #{name} : #{text:item}\n#{name}_value = tk.IntVar(value=#{checked})\n#{name} = tk.Checkbutton(#{win}, text=\"#{text}\", variable=#{name}_value, font=(\"Arial\", #{size}))\n\n<RPWI:VALUE>\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{fg}\n  #{name}.config(fg=\"#{fg}\")\n<RPWI:ENDTEST>\n<RPWI:TEST> #{bg}\n  #{name}.config(bg=\"#{bg}\")\n<RPWI:ENDTEST>\n#{name}.place(x=#{x}, y=#{y})\n<RPWI:TEST> #{w}\n  #{name}.place_configure(width=#{w})\n<RPWI:ENDTEST>\n<RPWI:TEST> #{h}\n  #{name}.place_configure(height=#{h})\n<RPWI:ENDTEST>",
 "rules": {
