 "mask": "<RPWI:NEWSTEP> Button #{name} : #{text:item}\n<RPWI:VALUE>\n<RPWI:POSITIVE>\n<RPWI:TEST> #{cmd}\n  #{name} = tk.Button(#{win}, text=\"#{text}\", font=(\"Arial\", #{size}))\n<RPWI:ENDTEST>\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{cmd}\n  #{name} = tk.Button(#{win}, text=\"#{text}\", font=(\"Arial\", #{size}), command=#{cmd})\n<RPWI:ENDTEST>\n\n<RPWI:VALUE>\n<RPWI:NEGATIVE>\n<RPWI:TEST> #{fg}\n  #{name}.config(fg=\"#{fg}\")\n<RPWI:ENDTEST>\n<RPWI:TEST> #{bg}\n  #{name}.config(bg=\"#{bg}\")\n<RPWI:ENDTEST>\n#{name}.place(x=#{x}, y=#{y})\n<RPWI:TEST> #{w}\n  #{name}.place_configure(width=#{w})\n<RPWI:ENDTEST>\n<RPWI:TEST> #{h}\n  #{name}.place_configure(height=#{h})\n<RPWI:ENDTEST>",
 "rules": {
